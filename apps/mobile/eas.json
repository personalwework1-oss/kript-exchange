{
  "cli": { "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_NETWORK": "testnet" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_NETWORK": "testnet" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_NETWORK": "mainnet" }
    }
  }
}
